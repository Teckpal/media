# ---------------------------------------------------------------------------
# motif Social — environment contract
# Copy to .env.local and fill. Never commit .env.local.
#
# NODE_ENV is not listed: Next.js sets it from the command being run.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the app's own API routes.
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" from Project Settings -> API. Carries the user's session
# through RLS; safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project JWT signing secret. Not read by the app; kept for tooling.
AUTH_JWT_SECRET=

# --- Token encryption ------------------------------------------------------
# AES-256-GCM key for OAuth tokens at rest. 32 bytes, base64.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Meta (Facebook + Instagram) -------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Confirm the current version in the Meta app dashboard before going live.
META_GRAPH_VERSION=v23.0

# --- X (Twitter) — API v2, OAuth 2.0 with PKCE ------------------------------
# developer.x.com -> a project + app -> User authentication settings.
# Redirect URI: {APP_URL}/api/connect/twitter/callback
# Scopes: tweet.read tweet.write users.read media.write offline.access
# Without offline.access X issues no refresh token and the connection dies
# after two hours with nothing to renew it.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- LinkedIn ----------------------------------------------------------------
# linkedin.com/developers -> app -> Auth. Redirect URI:
# {APP_URL}/api/connect/linkedin/callback
# The posting scopes (w_member_social, w_organization_social) need app review.
# Refresh tokens are only issued to approved apps; without one a connection
# lasts 60 days and then has to be redone.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn pins its REST API by date, not by path. Bump when they deprecate.
LINKEDIN_API_VERSION=202501

# --- TikTok — Content Posting API v2 -----------------------------------------
# developers.tiktok.com. Redirect URI: {APP_URL}/api/connect/tiktok/callback
# Scopes: user.info.basic, video.publish (review required).
# PULL_FROM_URL also needs the media domain verified with TikTok, or every
# publish fails with url_ownership_unverified however correct the rest is.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube — Google OAuth + Data API v3 ------------------------------------
# console.cloud.google.com -> OAuth client (Web). Redirect URI:
# {APP_URL}/api/connect/youtube/callback
# Scopes: youtube.upload, youtube.readonly. Google verification is required
# before the upload scope works outside a test-user list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments: Bangladesh (SSLCommerz) -------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# sandbox | live
SSLCOMMERZ_MODE=sandbox

# --- Payments: Global (Q6 undecided - adapter is stubbed) ------------------
GLOBAL_GATEWAY_PROVIDER=stub
GLOBAL_GATEWAY_API_KEY=
GLOBAL_GATEWAY_WEBHOOK_SECRET=

# --- Email -----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="motif Social <noreply@example.com>"

# --- Cron / internal job auth ----------------------------------------------
# Shared secret required by /api/cron/* and /api/internal/*
CRON_SECRET=

# --- Supabase direct Postgres connection (migrations only) -------------------
# Used by scripts/remote/*. The app never reads these.
#
# New Supabase projects no longer expose db.<ref>.supabase.co, so migrations go
# through the session-mode pooler on 5432. Transaction mode (6543) would break
# the multi-statement migration files.
#
# The password is set under Project Settings -> Database. It is shown once at
# project creation; "Reset database password" there issues a new one.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432

# --- Demo login used by scripts/shot.mjs ------------------------------------
# A seeded account (scripts/remote/seed-demo.mjs) so the screenshot driver can
# sign in and capture screens behind the router gate. Not read by the app.
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Free-for-now switch ----------------------------------------------------
# `true` bypasses the publish gate (Section 4 gate 2), the dashboard's
# connection requirement, and the onboarding paywall. Everything is usable
# without a plan.
#
# It defaults to OFF when unset, deliberately: a paywall bypass that defaults
# to on is one that reaches production, because nothing ever reminds you. The
# gates themselves are untouched and still tested — see
# src/lib/billing/open-access.ts. Delete this line to switch billing back on.
OPEN_ACCESS=true
